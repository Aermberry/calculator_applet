.keyboard {
  padding: 16rpx;
  background: #ffffff;
}

.row {
  display: flex;
  margin-bottom: 16rpx;
}

.key {
  flex: 1;
  margin: 0 8rpx;
  height: 110rpx;
  line-height: 110rpx;
  text-align: center;
  font-size: 44rpx;
  border-radius: 16rpx;
  background: #f2f3f5;
  color: #1a1a1a;
  transition: background-color 0.12s ease, transform 0.12s ease;
}

.key.fn {
  color: #fa5151;
}

.key.op {
  background: #e8f8ee;
  color: #07c160;
}

.key.eq {
  background: #07c160;
  color: #fff;
  flex: 1;
}

.key.wide {
  flex: 2;
}

/*
 * 按压态高亮：
 * 1) .key.key-hover —— 由 view 的 hover-class 在 touchstart 挂载，iOS/Android/开发者工具全端生效。
 *    类名叠加使特异性(0,3,0) 高于 .key.eq/.key.op(0,2,0)，不会被后置的配色规则覆盖。
 * 2) :active 兜底 —— 供支持该伪类的宿主（H5/部分浏览器内核）使用，同样写成叠加选择器。
 *    注意：:active 规则必须放在 .key.eq /.key.op 之后，否则会被同特异性(0,2,0)的后置规则吃掉，
 *    这正是等号键此前"按下去没反应"的原因。
 */
.key.key-hover {
  background: #e3e4e6;
  transform: scale(0.97);
}

.key.op.key-hover {
  background: #d3f2e0;
}

.key.eq.key-hover {
  background: #06ad56;
}

.key:active {
  background: #e3e4e6;
  transform: scale(0.97);
}

.key.op:active {
  background: #d3f2e0;
}

.key.eq:active {
  background: #06ad56;
}
